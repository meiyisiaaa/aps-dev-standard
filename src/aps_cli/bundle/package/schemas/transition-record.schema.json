{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-project-standard.local/schemas/transition-record.schema.json",
  "title": "APS Transition Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "recorded_at", "revision", "actor", "reason", "from_state", "to_state", "evidence_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^TRN-[A-Z0-9][A-Z0-9_-]*$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "from_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/state"}]},
    "to_state": {"$ref": "#/$defs/state"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decision_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "change_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "stage", "stage_type", "stage_status", "gate_status"],
      "properties": {
        "cycle": {"type": "string", "pattern": "^CYCLE-[0-9]{3,}$"},
        "stage": {"type": "integer", "minimum": 1, "maximum": 23},
        "stage_type": {"enum": ["GATED", "EXECUTION_LOOP", "OBSERVATION_LOOP", "ROUTER"]},
        "stage_status": {"enum": ["ACTIVE", "BLOCKED", "COMPLETE"]},
        "gate_status": {"enum": ["PENDING", "PASS", "REVISE", "HOLD", "STOP", null]}
      }
    }
  }
}
