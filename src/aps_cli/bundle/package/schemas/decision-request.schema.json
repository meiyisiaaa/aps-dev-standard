{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-project-standard/decision-request.schema.json",
  "title": "AI Project Standard Decision Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "cycle",
    "stage",
    "input_type",
    "question",
    "why_now",
    "options"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"enum": [1, 2]},
    "id": {"type": "string", "pattern": "^DEC-[A-Z0-9][A-Z0-9_-]*$"},
    "status": {"enum": ["PENDING", "RESOLVED", "CANCELLED"]},
    "cycle": {"type": "string", "pattern": "^CYCLE-[0-9]{3,}$"},
    "stage": {"type": "integer", "minimum": 1, "maximum": 23},
    "input_type": {
      "enum": ["single_select", "multi_select", "free_text", "number", "ranking", "approval", "matrix"]
    },
    "question": {"type": "string", "minLength": 1},
    "why_now": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "tradeoffs": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            ]
          }
        }
      }
    },
    "recommended": {"type": ["string", "null"]},
    "allow_custom": {"type": "boolean"},
    "allow_multiple": {"type": "boolean"},
    "allow_rank": {"type": "boolean"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "affected_areas": {"type": "array", "items": {"type": "string"}},
    "selected_option_ids": {"type": "array", "items": {"type": "string"}},
    "answer": {"type": "string"},
    "reason": {"type": "string"},
    "resolved_at": {"type": ["string", "null"]},
    "cancelled_at": {"type": ["string", "null"]},
    "decision_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "confirmation_method"],
      "properties": {
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "documentation", "time"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "documentation": {"type": "string", "minLength": 1},
            "time": {"type": "string", "minLength": 1}
          }
        },
        "confirmation_method": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {
        "required": ["decision_card", "recommended"],
        "properties": {
          "options": {"items": {"required": ["tradeoffs"]}}
        }
      }
    }
  ]
}
